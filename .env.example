# PLANTILLA PÚBLICA (se sube a GitHub): NO escriba claves reales aquí.
# Copie este archivo como .env.local (ignorado por git) y complete los valores ahí.
# Claves en: Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://SU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=su-clave-anon-o-publishable

# Solo servidor. Debe ser la clave SERVICE_ROLE / secret (NO la anon): alta de usuarios
# desde Ajustes y recibos/estados de cuenta públicos. Nunca la exponga en el navegador.
SUPABASE_SERVICE_ROLE_KEY=su-clave-service-role

# Solo servidor. Secreto exclusivo para firmar los enlaces que se envían al cliente
# (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Cambiarlo invalida todos los enlaces enviados.
LINK_SIGNING_SECRET=

# URL pública del sistema (para los enlaces de WhatsApp)
NEXT_PUBLIC_APP_URL=https://su-dominio.vercel.app
