# ============================================================================
#  PLANTILLA PÚBLICA — ESTE ARCHIVO SE SUBE A GITHUB.
#  NO escriba aquí ninguna clave real (GitHub bloqueará el push).
#  Las claves reales van SOLO en .env.local (ignorado por git) y en Vercel.
# ============================================================================
# Claves en: Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://SU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=su-clave-publishable

# Solo servidor. Debe ser la clave SECRET (sb_secret_...) — NO la anon/publishable:
# alta de usuarios desde Ajustes y recibos/estados de cuenta públicos.
SUPABASE_SERVICE_ROLE_KEY=su-clave-secret

# Solo servidor. Secreto exclusivo para firmar los enlaces que se envían al cliente
# (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Cambiarlo invalida todos los enlaces enviados.
LINK_SIGNING_SECRET=

# URL pública del sistema (para los enlaces de WhatsApp)
NEXT_PUBLIC_APP_URL=https://su-dominio.vercel.app
